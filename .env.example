# Copy this file to .env and adjust as needed.
# docker compose reads root-level values like JWT_SECRET/POSTGRES_*; the
# api/ and web/ directories also have their own .env for running services
# outside Docker.

# --- Shared / docker compose ---
JWT_SECRET=replace-with-a-long-random-string
POSTGRES_USER=bookmarked
POSTGRES_PASSWORD=bookmarked_dev_password
POSTGRES_DB=bookmarked

# --- api/.env ---
PORT=4100
DATABASE_URL=postgresql://bookmarked:bookmarked_dev_password@localhost:5433/bookmarked
JWT_SECRET=replace-with-a-long-random-string

# --- web/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:4100
